# Copy to .env and fill in. Run with: uv run --env-file .env dubstick

# discogs.com → Settings → Developers → Generate new token
DISCOGS_TOKEN=

# Music folders to look in before falling back to recordings and YouTube, colon-separated.
DUBSTICK_MUSIC=

# Bluetooth address of the P21, as listed by `dubstick-printer scan`.
DUBSTICK_PRINTER=

# Optional.
# DUBSTICK_DATA=./data
# DUBSTICK_ESSENTIA_WORKERS=2
# DUBSTICK_PORT=8000

# Used by deploy/compose.yml only.
DUBSTICK_HOST=dubstick.example.com
DUBSTICK_MUSIC_DIR=
